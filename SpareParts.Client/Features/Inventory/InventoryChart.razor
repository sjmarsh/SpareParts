@using SpareParts.Shared.Models;

@inject IInventoryService InventoryService
@inject IServiceWrapper ServiceWrapper

<div>
    <BarChart @ref="_barChart" />
    @if (_hasError)
    {
        <div class="alert alert-danger py-1">
            @_errorMessage
        </div>
    }
</div>


@code {
    private BarChart _barChart = default!;
    private BarChartOptions _barChartOptions = default!;
    private ChartData _chartData = default!;

    private bool _hasError;
    private string? _errorMessage;

    protected async override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var inventoryItems = await GetInventoryItems();
        if (inventoryItems == null || !inventoryItems.Any())
        {
            _hasError = true;
            _errorMessage = "No inventory items found.";
            return;
        }
        var labels = GetChartLabels(inventoryItems);
        var datasets = GetChartDatasets(inventoryItems);
        _chartData = new ChartData { Labels = labels, Datasets = datasets };
        _barChartOptions = new BarChartOptions { Responsive = true, Interaction = new Interaction { Mode = InteractionMode.Index } };
        await _barChart.InitializeAsync(_chartData, _barChartOptions);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _barChart.InitializeAsync(_chartData, _barChartOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private List<String> GetChartLabels(List<InventoryItemDetail> inventoryItems)
    {
        return inventoryItems.Select(i => i.PartName ?? $"Part ID: {i.ID}").Distinct().ToList() ?? new List<string>();
    }   

    private List<IChartDataset> GetChartDatasets(List<InventoryItemDetail> inventoryItems)
    {        
        var barChartDataSet = new BarChartDataset
        {
            Label = "Stock Levels",
            Data = inventoryItems.Select(i => (double?)i.Quantity).ToList(),
            BackgroundColor = inventoryItems.Select(i => "rgba(75, 192, 192, 0.2)").ToList(),
            BorderColor = inventoryItems.Select(i => "rgba(75, 192, 192, 1)").ToList(),
            BorderWidth = inventoryItems.Select(i => 1.0).ToList()
        };
        return new List<IChartDataset> { barChartDataSet };
    }

    private async Task<List<InventoryItemDetail>> GetInventoryItems()
    {
        bool isCurrentOnly = true; // todo add a toggle for this
        int totalItemCount = 0;
        int pageSize = 20; // todo adjust this based on total item count
        List<InventoryItemDetail> inventoryItems = new List<InventoryItemDetail>();

        var response = await ServiceWrapper.ServiceCall(() => InventoryService.IndexDetail(isCurrentOnly, 0, pageSize), "An error occurred retrieving inventory items.");

        if (response == null)
        {
            _hasError = true;
        }
        else
        {
            if (response.HasError)
            {
                _hasError = true;
                _errorMessage = response.Message;
            }

            inventoryItems = response.Items?
                .Where(r => r.PartName != null)
                .OrderBy(i => i.PartName)
                .ThenByDescending(i => i.DateRecorded)
                .ToList()
                ?? new List<InventoryItemDetail>();

            totalItemCount = response.TotalItemCount;
        }

        return inventoryItems;
    }
}
